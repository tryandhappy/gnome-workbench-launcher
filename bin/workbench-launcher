#!/usr/bin/env bash
# Workbench Launcher 拡張機能をコマンドラインから操作する。
#
#   workbench-launcher launch <workbench-id> [--wait SECONDS]
#   workbench-launcher raise <workbench-id> [--only]
#   workbench-launcher cycle [--only]
#   workbench-launcher list
#   workbench-launcher reload
#
# 拡張機能が公開する D-Bus インターフェースを呼び出す。--wait を付けると、
# ログイン直後などで拡張機能がまだ有効になっていない場合に、指定秒数まで再試行する。
# raise はワークベンチのウィンドウを前面に出す（起動していなければ起動する）。
# cycle は起動中のワークベンチを設定の並び順で切り替える。--only は他のウィンドウを最小化する。
set -euo pipefail

dest='org.gnome.Shell'
object_path='/org/gnome/Shell/Extensions/WorkbenchLauncher'
interface='org.gnome.Shell.Extensions.WorkbenchLauncher'

usage() {
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

call() {
    gdbus call --session --dest "$dest" --object-path "$object_path" \
        --method "$interface.$1" "${@:2}"
}

[[ $# -ge 1 ]] || usage 1

case "$1" in
    -h|--help|help) usage ;;
    list)
        call ListWorkbenches | sed -e "s/^(\[//" -e "s/\],)$//" -e "s/', '/\n/g" -e "s/^'//" -e "s/'$//"
        ;;
    reload)
        call Reload >/dev/null
        ;;
    raise)
        [[ $# -ge 2 ]] || usage 1
        only=false
        [[ "${3:-}" == "--only" ]] && only=true
        call RaiseWorkbench "'$2'" "$only" >/dev/null
        ;;
    cycle)
        only=false
        [[ "${2:-}" == "--only" ]] && only=true
        call CycleWorkbench "$only" | sed -e "s/^('//" -e "s/',)$//"
        ;;
    launch)
        [[ $# -ge 2 ]] || usage 1
        workbench_id="$2"
        wait_seconds=0
        if [[ "${3:-}" == "--wait" ]]; then
            wait_seconds="${4:-30}"
        fi
        deadline=$((SECONDS + wait_seconds))
        while :; do
            if output="$(call LaunchWorkbench "'$workbench_id'" 2>&1)"; then
                exit 0
            fi
            # 拡張機能側が明示的に拒否した場合（未知の ID など）は待たずに終了する
            if [[ "$output" == *"設定にありません"* ]]; then
                printf '%s\n' "$output" >&2
                exit 1
            fi
            if (( SECONDS >= deadline )); then
                printf '%s\n' "$output" >&2
                printf 'Workbench Launcher 拡張機能に接続できません。有効になっているか確認してください。\n' >&2
                exit 1
            fi
            sleep 1
        done
        ;;
    *)
        usage 1
        ;;
esac
